# Copy to .env and fill in. .env is gitignored.

# --- Auth ---
# Admin code that grants teacher access. Pick something long and random.
TEACHER_PASSWORD=

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, sessions use an ephemeral per-process secret (broken across restarts
# and multi-worker deployments).
SESSION_SECRET=

# Session lifetime in seconds (default 28800 = 8h).
SESSION_TTL_SECONDS=28800

# Set to 0 only for local HTTP development. Required for any non-HTTPS deploy.
COOKIE_SECURE=1
COOKIE_SAMESITE=lax

# --- Deployment ---
# 1 hides tracebacks from API responses; 0 returns them (dev only).
PRODUCTION=0

# Comma-separated list of allowed cross-origin sites for the API. Leave empty
# if the frontend is served by this same FastAPI app (same-origin).
# Example: ALLOWED_ORIGINS=https://mathgrade.example.com
ALLOWED_ORIGINS=

# --- AI keys ---
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

GEMINI_API_KEY=AQ.Ab8RN6J_ZABXFYPMchQwt1tXKTDdKy-dxMV40Oz8SIrPRqu9Uw

OPENAI_API_KEY=